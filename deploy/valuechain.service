[Unit]
Description=Value Chain midterm trainer
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/var/www/chulavaluechain
# Bound to loopback: Apache is the only thing that should reach it, and firewalld
# never has to know this port exists.
ExecStart=/var/www/chulavaluechain/chulavaluechain \
    -addr 127.0.0.1:8093 \
    -behind-proxy \
    -db /var/lib/chulavaluechain/study.db
User=wilhelm
Restart=always
RestartSec=10
SyslogIdentifier=chulavaluechain

# Unlike the courts app, this one has state: the leaderboard has to survive a restart,
# so it gets exactly one writable directory and nothing else.
StateDirectory=chulavaluechain
StateDirectoryMode=0750

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/var/www/chulavaluechain
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
