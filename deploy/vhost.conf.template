# Apache vhost template. One per course: copy it, replace COURSE and PORT, install as
# /etc/httpd/conf.d/<course>.conf, then let certbot add the TLS vhost.
#
#   sed -e s/COURSE/valuechain/g -e s/PORT/8093/ deploy/vhost.conf.template > /tmp/v.conf
#
# Install as /etc/httpd/conf.d/valuechain.conf, then let certbot add the TLS vhost:
#   sudo certbot --apache -d COURSE.wilhelm.my
# certbot rewrites this file to redirect :80 to :443 and writes the matching
# <VirtualHost *:443> with the certificate paths.

<VirtualHost *:80>
    ServerName COURSE.wilhelm.my
    ServerAdmin wilhelm@durelius.se

    ErrorLog logs/COURSE-error_log
    CustomLog logs/COURSE-access_log common

    # The whole app is the Go process: the SPA, its assets and /api all come from it.
    ProxyPreserveHost On
    ProxyPass / http://127.0.0.1:PORT/
    ProxyPassReverse / http://127.0.0.1:PORT/

    RequestHeader set X-Forwarded-Proto "https"

    # Compress text responses. The app is a single-page build whose JavaScript bundle is
    # ~460 KB uncompressed and ~140 KB gzipped. Sent uncompressed over a weak mobile
    # link the transfer gets cut off part-way, and the result is a blank page: the HTML
    # and CSS arrive, the script does not, and a single-page app renders nothing without
    # its script. Apache logs those as 200 — the response started fine — so the failure
    # is only visible in the byte counts.
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json image/svg+xml
</VirtualHost>
